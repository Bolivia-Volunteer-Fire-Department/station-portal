rules_version = '2';

// THE ENFORCEMENT, after the move off Google Sheets.
//
// Every rule here is a check that lives in Code.gs today: `hasRolePermission`, the projections that hand a member
// a safe copy of a row, the officer-only actions. Those checks cannot move to Firestore as they are - a rule
// cannot strip a field or filter a row - so the shapes in docs/FIRESTORE_MODEL.md exist to make each document's
// whole contents safe for whoever may read it, and this file states who that is.
//
// Three things are deliberate, and worth knowing before editing:
//
//   1. THE ROLE DOCUMENT IS THE SOURCE OF TRUTH, not the token. `is_admin` and `role_id` also ride in the custom
//      claims so the client can shape its navigation without a read, but claims refresh about hourly - a rule
//      that trusted them would let someone keep access for up to an hour after an officer removed it. These rules
//      read users_private/{uid} then roles/{roleId}: at most four document reads, and a role change takes effect
//      on the very next request.
//   2. EVERYTHING IS DENIED UNLESS IT IS WRITTEN HERE. Collections still to come are denied by the catch-all at
//      the bottom, and each gets its rules in the phase that brings its client code: an untested rule is worse
//      than a missing one.
//   3. A COLLECTION THAT IS SAFE FOR EVERY MEMBER IS SIMPLY READABLE. The schedule is the example - members are
//      meant to see the crew's shifts, so the rule is "any signed-in member" and the *query* narrows it. That is
//      also why the calendar asks two questions (my shifts, and open shifts) instead of one clever one: each query
//      is unambiguous, and no rule has to reason about a disjunction.
//
// scripts/verify-rules.mjs runs against the emulator: it seeds the demo station, signs in as a member and as an
// officer, and asserts what each may read and write - including what they may NOT.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // The viewer's roster row and their role, each read ONCE per evaluation.
    //
    // These are deliberately FLAT: no helper calls another helper. The earlier version chained them - roleId() called
    // viewerRow() twice, role() called roleId() twice, and permission() called role() three times - so a rule that
    // checked two flags multiplied the same handful of document reads into hundreds of expressions and Firestore
    // refused to evaluate it at all: "the maximum of 1000 expressions to evaluate has been reached", which a client
    // sees as permission-denied, indistinguishable from a correct refusal. One document, read once, handed down.
    //
    // Every segment and every field read is guarded, for the same family of reasons: an empty path segment
    // ("users/"), a document that does not exist, and an absent key all produce an EVALUATION ERROR in these rules
    // rather than a false. `get(key, default)` is the supported way to read a field that may be missing.
    //
    // What a check costs: two existence checks and two reads (the roster row, then the role), all cached within the
    // request. A rule that needs to read several more documents than that per check will not fit in the allowance.
    function viewerRole() {
      return uid() == null
        ? null
        : (exists(/databases/$(database)/documents/users/$(uid()))
          ? get(/databases/$(database)/documents/users/$(uid())).data
          : null);
    }

    // The role document for a roster row. It takes the row rather than reading it again, which is what keeps the
    // whole path to two document reads however many times a rule asks about permissions.
    function roleFor(viewer) {
      let roleRef = viewer == null ? '' : viewer.get('role_id', '');
      return roleRef == ''
        ? null
        : (exists(/databases/$(database)/documents/roles/$(roleRef))
          ? get(/databases/$(database)/documents/roles/$(roleRef)).data
          : null);
    }

    // The keys an announcement or an event must carry for this viewer to see it: everyone, or them, or their role,
    // or their rank. One list, because the client asks ONE question with array-contains-any and the rule answers it
    // with hasAny - a shape Firestore can prove, unlike an OR across three columns.
    function viewerKeys() {
      let viewer = viewerRole();
      return [
        '*',
        'user:' + uid(),
        'role:' + (viewer == null ? '' : viewer.get('role_id', '')),
        'rank:' + (viewer == null ? '' : viewer.get('rank_id', '')),
      ];
    }

    // `is_admin` is the master switch: it implies every other permission.
    //
    // `is_admin` is the master switch: it implies every other permission.
    //
    // A ROLE DOCUMENT CARRIES EVERY FLAG, as the roles sheet had a column for each one. That is an invariant, not a
    // convenience: reading an absent key in these rules is an EVALUATION ERROR rather than a false, and a client
    // cannot tell that apart from a rule that correctly denies - which is exactly how a missing "can_make_offers"
    // made creating an offer fail for the right-looking reason. "Not granted" is written down as false, and the role
    // editor is what keeps it that way.
    //
    // ONE FIELD, TWO READINGS - and this is the whole of the "I am an administrator" bug.
    //
    // The CLIENT already accepts a role flag written as the sheet's `"TRUE"`: `isTruthyFlag` (utils/rankEligibility.js) is
    // `value === true || String(value).trim().toUpperCase() === 'TRUE'`, and `permissionGranted` is built on it. That
    // tolerance exists because the roles sheet is maintained by hand and every flag on it arrived as text.
    //
    // These rules used to accept only the boolean. So a role document carrying the sheet's spelling - `is_admin: "TRUE"` -
    // opened EVERY Administration tab, every panel and every button, and then refused every single write with
    // permission-denied. The client said "administrator"; the server said "no". Nothing on screen could explain that,
    // because from the member's side the whole module was plainly there.
    //
    // The server now reads a flag EXACTLY as the client does, which is the point: one definition of "granted", so the
    // buttons a member can see are the writes the server will accept. Widening the spelling here grants nothing new -
    // `roles` is writable only by `can_edit_roles`, so whoever can write this value could have written `true` instead.
    // THE TYPE CHECK IS A NESTED TERNARY, not `&&`, and that is not a style choice. Written as
    // `value == true || (value is string && value.trim().upper() == 'TRUE')`, this ERRORED on a role document holding a
    // real boolean `false` - the `.trim()` was reached anyway, `.trim` came back undefined, and an evaluation error is
    // indistinguishable from a refusal in the log, so every permission-gated rule in the file failed at once with no
    // clue which line was wrong. A ternary evaluates one branch and never the other, so the method call only runs on a
    // string. (Rules functions take a single `return` expression, so statements are not an option.)
    function granted(value) {
      return value == true ? true : (value is string ? value.trim().upper() == 'TRUE' : false);
    }

    function permission(name) {
      let role = roleFor(viewerRole());
      return role != null && (granted(role.get('is_admin', false)) || granted(role.get(name, false)));
    }

    function isAdministrator() {
      let role = roleFor(viewerRole());
      return role != null && granted(role.get('is_admin', false));
    }

    function roleIsAdministrator(roleId) {
      return roleId is string
        ? (roleId == ''
          ? false
          : (exists(/databases/$(database)/documents/roles/$(roleId))
            ? granted(get(/databases/$(database)/documents/roles/$(roleId)).data.get('is_admin', false))
            : false))
        : false;
    }

    function checklistItemMatchesParent(item) {
      let documentId = item.get('document_id', '');
      let itemAudience = item.get('audience_keys', null);
      return itemAudience is list
        && documentId is string
        && documentId != ''
        && existsAfter(/databases/$(database)/documents/documents/$(documentId))
        && itemAudience == getAfter(/databases/$(database)/documents/documents/$(documentId)).data.get('audience_keys', []);
    }

    function hasAvailabilityIdentity(docId, data) {
      let memberId = data.get('user_id', '');
      let month = data.get('month', '');
      return memberId is string
        && memberId != ''
        && month is string
        && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && docId == memberId + '_' + month;
    }

    // ---------------------------------------------------------------------------------------------
    // Identity and access
    // ---------------------------------------------------------------------------------------------

    // The roster: a name and a rank, and nothing else. Every member reads it, because the schedule stores only
    // user ids and the calendar has to label other people's shifts with them.
    match /users/{userId} {
      allow read: if signedIn();
      // The officer's own save edits these three fields and no others. The shape of this document IS the
      // projection that used to be computed on the server: a field that is not listed here does not exist.
      // The officer's own save edits these fields and no others. The shape of this document IS the
      // projection that used to be computed on the server: a field that is not listed here does not exist.
      // `exclude_from_scheduling` and `runner_sound_profile` joined the list when the Users tab needed them - they are
      // facts about a member's place in the station rather than secrets about them, and they live on this document.
      // Everything else about an account (the username, the status, the password-change flag) still goes through a
      // callable, because those are the facts a client must not be able to rewrite about itself.
      allow create: if permission('can_edit_users')
        && request.resource.data.keys().hasOnly(['name', 'rank_id', 'role_id', 'exclude_from_scheduling', 'runner_sound_profile'])
        && (isAdministrator() || !roleIsAdministrator(request.resource.data.get('role_id', '')));
      allow update: if permission('can_edit_users')
        && request.resource.data.keys().hasOnly(['name', 'rank_id', 'role_id', 'exclude_from_scheduling', 'runner_sound_profile'])
        && (isAdministrator()
          || (!roleIsAdministrator(resource.data.get('role_id', ''))
            && !roleIsAdministrator(request.resource.data.get('role_id', ''))));
      allow delete: if permission('can_edit_users');
    }

    // The private half: the username, the account status, the officer notes. Read by the member (it is their own
    // account) and by officers. Written by NOBODY: creating a member and changing a username or a status goes
    // through a callable function, which is what stops a client inventing an account or un-suspending itself. The
    // Admin SDK bypasses this file - that is the point.
    // A field a browser may write on a member's private row: a string, and no longer than that field is meant to be.
    // A helper rather than repeating the clause, so the two branches below cannot drift apart in what they require.
    function privateText(key, limit) {
      return request.resource.data.get(key, '') is string
        && request.resource.data.get(key, '').size() <= limit;
    }

    match /users_private/{userId} {
      allow read: if signedIn() && (uid() == userId || permission('can_edit_users'));
      // THE PRIVATE HALF IS OTHERWISE WRITTEN BY NOBODY, and it stays that way for the username, the status and the
      // password-change flag - which is the whole point of this collection being write-denied: a browser must not be
      // able to unsuspend itself by rewriting its own row.
      //
      // TWO BRANCHES, because the two people who may write here do not own the same fields. A MEMBER keeps their own
      // contact details up to date - email, phone, FEMA student id - and MEMBER ID IS DELIBERATELY NOT AMONG THEM: the
      // station issues it and recycles it when somebody goes inactive, so it is not the member's to choose. AN OFFICER
      // with the user permission may correct anybody's, the member id included.
      //
      // `affectedKeys().hasOnly(...)` is what makes both narrow rather than a hole: a crafted request cannot move a
      // status or a username through either branch, so every other fact still requires the callable.
      allow update: if signedIn()
        && uid() == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fema_student_id', 'email', 'phone'])
        && privateText('fema_student_id', 40)
        && privateText('email', 120)
        && privateText('phone', 40);
      allow update: if signedIn()
        && permission('can_edit_users')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fema_student_id', 'email', 'phone', 'member_id'])
        && privateText('fema_student_id', 40)
        && privateText('email', 120)
        && privateText('phone', 40)
        && privateText('member_id', 20);
      allow create, delete: if false;
    }

    // The permission table. Every client reads it to shape its navigation; only a role editor writes it. A role
    // that GRANTS administrator access is special: only an administrator may create or change one, or a role
    // editor could hand themselves the whole app.
    //
    // THIS GUARD USES `granted()`, NOT `== true`, and that is load-bearing rather than tidiness. It reads the flag the
    // same way `permission()` does, so it keeps meaning the same thing after the widening above: with a bare `!= true`
    // the string `"TRUE"` would count as "not an administrator", and any role editor could have written one and become
    // an administrator - the exact thing these two lines exist to prevent. The escalation guard has to be written in the
    // same dialect as the permission it is guarding, or it stops guarding anything.
    //
    // `.get(...)` rather than `.data.is_admin` for the same reason as everywhere else in this file: a role document with
    // no `is_admin` key at all must read as "not an administrator", not as an evaluation error.
    match /roles/{roleId} {
      allow read: if signedIn();
      allow create: if permission('can_edit_roles')
        && (!granted(request.resource.data.get('is_admin', false)) || isAdministrator());
      allow update: if permission('can_edit_roles')
        && (isAdministrator() || !granted(resource.data.get('is_admin', false)))
        && (!granted(request.resource.data.get('is_admin', false)) || isAdministrator());
      allow delete: if permission('can_edit_roles') && !granted(resource.data.get('is_admin', false));
    }

    match /ranks/{rankId} {
      allow read: if signedIn();
      allow write: if permission('can_edit_ranks');
    }

    // One document per member, keyed by the member's id, so "your own document" is the whole rule. The FCM device
    // token is NOT here - it lives in push_devices, which is what lets this document be plainly readable.
    match /user_settings/{userId} {
      // The member's own, and the two officer permissions that have business here: `can_edit_users` for the user
      // editor, and `can_edit_notification_settings` for the notifications tab - which lists every member's
      // preferences and toggles the push flag, exactly as the sheet's version did. What lives here is a time format, a
      // dark-mode preference, notification preferences and the push flag: nothing sensitive, and all of it something
      // those officers already read.
      allow read, write: if signedIn()
        && (uid() == userId
          || permission('can_edit_users')
          || permission('can_edit_notification_settings'));
    }

    // A device token belongs to the member whose browser registered it; an officer reads the collection for the
    // FCM status tab. user_id is checked on the way IN as well as out, so a member cannot register a device
    // against somebody else's account.
    match /push_devices/{deviceId} {
      allow read: if signedIn()
        && (resource.data.user_id == uid() || permission('can_edit_notification_settings'));
      allow create: if signedIn() && request.resource.data.user_id == uid();
      allow update, delete: if signedIn()
        && (resource.data.user_id == uid() || permission('can_edit_notification_settings'));
    }

    // ---------------------------------------------------------------------------------------------
    // Configuration
    // ---------------------------------------------------------------------------------------------

    // Public by definition: the department name, the loading messages, the clock-location rules. The login screen
    // reads the public document before anyone has signed in, which is why that read does not require a session.
    // The private document is the other half: whoever may change a setting may read it. Nothing sensitive lives in
    // this collection at all - the FCM credentials moved to function secret storage.
    match /settings/{settingId} {
      allow read: if settingId == 'public' || permission('can_edit_system_settings');
      allow write: if permission('can_edit_system_settings');
    }

    match /shifts/{shiftId} {
      allow read: if signedIn();
      allow write: if permission('can_edit_schedule');
    }

    // The station's availability windows: a short, officer-maintained list of recurring weekly patterns that members
    // choose from (utils/availability.js). Everybody reads it - a member's own module draws its options from it - and
    // only somebody who maintains member availability may change it. Rank plays no part here, deliberately: a window is
    // an hour of the station's week, not a slot somebody has to qualify for.
    // The list every member chooses from, maintained by an officer: `can_edit_availability_windows` is the permission for
    // shaping the station's week, kept separate from managing one member's claims (`can_edit_member_availability`).
    match /availability_windows/{windowId} {
      allow read: if signedIn();
      allow write: if permission('can_edit_availability_windows');
    }

    match /apparatus/{apparatusId} {
      allow read: if signedIn();
      allow write: if permission('can_edit_schedule');
    }

    // The split that keeps an officer's private note off a member's screen: the fields members draw are in
    // `assignments`, and the note is in a document only officers may read. Not a copy - two disjoint halves.
    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow write: if permission('can_edit_assignments');
    }

    match /assignment_private/{assignmentId} {
      allow read, write: if permission('can_edit_assignments');
    }

    match /schedule_templates/{templateId} {
      allow read: if signedIn();
      allow write: if permission('can_edit_schedule_templates');
    }

    match /schedule_template_private/{templateId} {
      allow read, write: if permission('can_edit_schedule_templates');
    }

    // ---------------------------------------------------------------------------------------------
    // The schedule and the clock
    // ---------------------------------------------------------------------------------------------

    // Everything about everybody's shifts, readable by any member - deliberately, because the calendar offers a
    // "Show everyone" view and labels other people's pills. The narrowing happens in the query (a date range, my
    // shifts, or open shifts), not here.
    //
    // WRITE-DENIED, and that is the point: saveScheduleBoard in functions/index.js is the only writer of a schedule
    // row, because a board save needs the audit row (which no client may write) and a slot-conflict check against
    // the rows as they are at that moment (which needs a query inside a transaction - a thing the Admin SDK can do
    // and the browser SDK cannot). An approved offer reaches the same collection through the same file.
    match /schedule/{scheduleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // One row per member per date: ten thousand a year at station scale. `user_id` is the caller, and that is the
    // whole rule - the sheet version sent the whole table to everybody and filtered it in the browser.
    //
    // `resource != null` on the update and delete branches is not padding: Firestore checks those branches while
    // evaluating a CREATE, where `resource` is null, and reading `.data` off it is an evaluation error - which a
    // client cannot tell apart from a correct refusal. Guarding it is what makes the refusal a refusal.
    // ONE MEMBER'S CLAIMS FOR ONE MONTH, and the document is the unit of both reading and writing.
    //
    // The id carries the owner (`u2_2026-09`) so this rule can prove who may read a document without reading anything
    // else - the same convention as `on_duty/{memberId}` - and a `month` field lets an officer ask for one month across
    // the whole crew in a single query. That query is the reason the shape changed: a row per claim cost ~240 document
    // reads for a month of a 30-member station, and a document per member per month costs ~30.
    //
    // `resource != null` on the update and delete branches is not padding: Firestore checks those branches while
    // evaluating a CREATE, where `resource` is null, and reading `.data` off it is an evaluation error - which a client
    // cannot tell apart from a correct refusal.
    match /availability_months/{docId} {
      allow read: if signedIn()
        && (resource == null
          || resource.data.user_id == uid()
          || permission('can_edit_member_availability'));
      allow create: if signedIn()
        && hasAvailabilityIdentity(docId, request.resource.data)
        && (request.resource.data.user_id == uid() || permission('can_edit_member_availability'))
        && request.resource.data.claims is map;
      allow update: if signedIn()
        && resource != null
        && hasAvailabilityIdentity(docId, resource.data)
        && hasAvailabilityIdentity(docId, request.resource.data)
        && request.resource.data.user_id == resource.data.user_id
        && (request.resource.data.user_id == uid() || permission('can_edit_member_availability'))
        && request.resource.data.claims is map;
      allow delete: if signedIn()
        && resource != null
        && (resource.data.user_id == uid() || permission('can_edit_member_availability'));
    }

    // Clock entries, written by the clock in/out TRANSACTION, which also writes the on_duty row so the two cannot
    // Member clock entries are written by Functions, which owns server timestamps and the paired on_duty transaction.
    // Coordinates are client-reported; location attestation remains a separate trust limitation.
    match /timeclock/{entryId} {
      // The same null guard as `document_signatures`, and for the same reason: this is read as a QUERY
      // (`where('user_id', '==', uid).where('time_out', '==', '')`, in `openClockEntryFor`), and `.data` off a null
      // `resource` is an evaluation error a client cannot tell from a refusal. Here the member's own query IS provable
      // from its constraint, so it never reaches the null case - the guard is the file's standard rather than a fix, and
      // it is kept for the same reason as the other two: so that a later edit fails as a refusal rather than as an error.
      allow read: if signedIn()
        && ((resource != null && resource.data.user_id == uid()) || permission('can_edit_timeclock'));
      // An entry OPENS with no time_out and belongs to the caller: a member cannot open a shift for somebody else, and
      // Direct writes are limited to Clock Management; member clock actions use the callables above.
      allow create, update, delete: if permission('can_edit_timeclock');
    }

    // Who is on duty, materialized by that same transaction so the two cannot disagree. One small document per
    // clocked-in member, keyed by their id - which is why the rule is simply "your own key". Readable by everyone,
    // because the dashboard shows it.
    match /on_duty/{memberId} {
      allow read: if signedIn();
      allow write: if permission('can_edit_timeclock');
    }

    // The audit trail is NOT here any more, and there is no permission to hold for it: the app's audit lines go to
    // Cloud Logging (see `audit` in functions/index.js), which is free to write, searchable in the Firebase console, and
    // does not need a collection that grows without limit and a whole-collection scan to render one screen.

    // ---------------------------------------------------------------------------------------------
    // The member payload's remaining collections
    // ---------------------------------------------------------------------------------------------

    // Announcements and events are audience-filtered inside a server function today (announcementMatches,
    // eventsForViewer). Here the audience is MATERIALIZED on the document as `audience_keys`: one array of strings,
    // each 'role:<id>', 'rank:<id>', 'user:<id>', or '*' for everyone. The client asks one question -
    // array-contains-any over its own keys - and the rule checks the same list with hasAny, which is what makes the
    // query provably safe.
    //
    // The sheet version reads three separate columns and ORs them, and an OR cannot be proven for a query. That is
    // the whole reason this shape changed: "everyone" is '*', and "this rank or above" is expanded to the concrete
    // rank ids when the announcement is written, because a query cannot compare rank orders either.
    match /announcements/{announcementId} {
      // The officer branch comes FIRST and is not decoration: the Announcements tab reads the WHOLE collection, and
      // Firestore refuses a query it cannot prove safe. For a member the audience list is the proof; for an officer
      // the permission is. The `resource != null` guard is this file's own rule of the road - a get by id on a
      // document that does not exist evaluates the read rule with resource null, and `.data` off null is an
      // evaluation error, which a client sees as permission-denied.
      allow read: if signedIn()
        && (permission('can_make_announcements')
          || (resource != null && resource.data.audience_keys.hasAny(viewerKeys())));
      allow write: if permission('can_make_announcements');
    }

    match /events/{eventId} {
      // Events the same way: the calendar's admin view reads every event, so the officer branch is what makes that
      // query provable. See the note on announcements above for why it comes first, and the null guard.
      allow read: if signedIn()
        && (permission('can_create_events')
          || (resource != null && resource.data.audience_keys.hasAny(viewerKeys())));
      allow write: if permission('can_create_events');
    }

    // Report definitions contain their role/rank audience materialized as `audience_keys`. All writes are currently
    // callable-only so the server can validate the definition and audit the change; direct reads still obey the same
    // global Reports permission plus audience intersection if a client ever reads this collection directly.
    match /report_configs/{reportId} {
      allow read: if signedIn()
        && (permission('can_configure_reports')
          || (permission('can_view_reports')
            && resource != null
            && resource.data.get('enabled', false) == true
            && resource.data.get('audience_keys', []).hasAny(viewerKeys())));
      allow write: if false;
    }

    // A form definition: which blank PDF, which data feeds it, and which value goes in which field.
    //
    // WRITTEN DIRECTLY, unlike a report definition: there is no server-side work to do that the client's
    // `normalizeFormDefinition` does not already do, no audience to expand that `formAudienceKeys` does not already
    // build, and no audit row a definition needs. So the rule is the permission, and the writer is the browser.
    //
    // READ BY ITS AUDIENCE, through the same materialized `audience_keys` list announcements use - so the member's query
    // (array-contains-any over their own keys) is the SAME question the rule answers with hasAny, and Firestore can
    // prove it. `enabled` is deliberately NOT checked here: a condition the query does not filter on would make the
    // query unprovable, so a disabled form is filtered by the reader instead (see firestoreReads#GET_FORM_TEMPLATES).
    match /form_templates/{formId} {
      allow read: if signedIn()
        && (permission('can_configure_forms')
          || (resource != null && resource.data.get('audience_keys', []).hasAny(viewerKeys())));
      allow create, update: if permission('can_configure_forms')
        && request.resource.data.get('name', '') != ''
        && request.resource.data.get('fields', {}).size() > 0
        // A form aims at someone: an empty audience would be readable by nobody, which is a definition to fix rather
        // than to save.
        && request.resource.data.get('audience_keys', []).size() > 0;
      allow delete: if permission('can_configure_forms');
    }

    // The training list is everyone's; the signatures differ by permission. The permission is a fact about the
    // READER, which is why the rule reads the role document rather than the row.
    match /trainings/{trainingId} {
      allow read: if signedIn();
      allow write: if permission('can_edit_trainings');
    }

    match /training_signatures/{signatureId} {
      allow read: if signedIn()
        && (resource.data.user_id == uid() || permission('can_administer_trainings'));
      allow create: if signedIn() && request.resource.data.user_id == uid() && permission('can_sign_trainings');
      // OFFICER-ONLY, and this is narrower than it used to be. The member's own row was deletable by the member, which
      // is the opposite of what the sheet's handler did: it REFUSED a removal outright ("signatures cannot be removed,
      // ask an administrator to correct a signature"), because a signature is an acknowledgment of attendance rather
      // than a preference. A rule that allows a crafted request to do what the handler refuses is not the rule the
      // handler describes - so the withdrawal is an administrator's action at the level the data is protected, not only
      // at the level the button is drawn.
      allow update, delete: if signedIn() && permission('can_administer_trainings');
    }

    // The catalog everyone reads, and one member's own records: the same shape as the clock and the availability
    // rows, for the same reason - a record is a per-member row that grows with the roster.
    match /certification_setup/{typeId} {
      allow read: if signedIn();
      allow write: if permission('can_manage_certification_setup');
    }

    match /certifications/{recordId} {
      allow read: if signedIn()
        && (resource.data.user_id == uid() || permission('can_manage_certifications'));
      allow write: if permission('can_manage_certifications');
    }

    // The evidence attached to a certification record: one optional file per period, holding the object's PATH in
    // the bucket and never a download URL - a download URL carries a token, which is a secret that works for
    // whoever holds it, so it is minted when somebody opens the file and never stored.
    //
    // READ-ONLY FROM HERE, and that is the whole difference from `certifications` above: the row is written by
    // functions/index.js#saveCertificationFile, which is the only place that can check the two things a rule
    // cannot - that the file it names is really in the bucket, and that it belongs to the member on the record it
    // claims. A browser has no business inventing an attachment.
    //
    // `resource == null` first, for the reason the offers rule below spells out: asking "is there a file against
    // this record?" reads a document that may not exist, and `.data` off null is a null value error rather than a
    // false - which a client cannot tell apart from a refusal.
    match /certification_files/{fileId} {
      allow read: if signedIn()
        && (resource == null
          || resource.data.user_id == uid()
          || permission('can_manage_certifications'));
      allow write: if false;
    }

    // Offers: a member raises one for an open shift, withdraws their own, and an officer approves one - the approval
    // is what writes the schedule row, so it is an officer's write either way.
    match /schedule_offers/{offerId} {
      // `resource == null` first, and this is a rule worth copying to every read rule that inspects `resource.data`:
      // reading a document that does NOT exist evaluates the read rule with `resource` null, and `.data` off null is
      // a Null value error - which a client sees as permission-denied. Asking "does this offer exist?" is an ordinary
      // thing for a screen to do, and the honest answer is "no", not "you may not know".
      allow read: if signedIn()
        && (resource == null
          || resource.data.user_id == uid()
          || permission('can_approve_shifts')
          || permission('can_edit_schedule'));
      // A member may raise an offer on their own behalf, and only as a pending one: the status is not theirs to set
      // to approved.
      allow create: if signedIn()
        && request.resource.data.user_id == uid()
        && request.resource.data.status == 'pending'
        && permission('can_make_offers');
      // Withdrawing is a DELETE, and approving is an UPDATE the member cannot make: owning an offer must not mean
      // being able to change its status to approved, which is the one field that matters.
      allow update: if signedIn() && permission('can_approve_shifts');
      allow delete: if signedIn()
        && (resource.data.user_id == uid() || permission('can_approve_shifts'));
    }

    // Badges for the types that ask for one, materialized: the icon beside a member's name depends on EVERY member's
    // records, and a member may only read their own - so the answer is a small public-safe document per member rather
    // than a query nobody but an officer could run. Written by the certification work in Phase 4; the rules already
    // say who may.
    match /certification_badges/{memberId} {
      allow read: if signedIn();
      allow write: if permission('can_manage_certifications');
    }

    // Documents: the guides members read and sign, and the items they are signed against.
    //
    // These three arrived with their client code rather than with the rest, and until now the catch-all denied them -
    // which is why no screen could read them at all. The read rule is the announcements shape (an audience list a
    // query can prove) with the two officer branches first, because the Documents tab reads the whole collection and
    // a whole-collection read has to be provable.
    match /documents/{documentId} {
      allow read: if signedIn()
        && (permission('can_manage_documents')
          || permission('can_verify_documents')
          || (resource != null && resource.data.audience_keys.hasAny(viewerKeys())));
      allow write: if permission('can_manage_documents');
    }

    match /document_checklist_items/{itemId} {
      // Checklist items inherit the parent document's audience. The child copy keeps member queries provable;
      // matching it against the parent prevents stale or forged child audiences from widening access.
      allow read: if signedIn()
        && (permission('can_manage_documents')
          || permission('can_verify_documents')
          || (resource != null && resource.data.audience_keys.hasAny(viewerKeys())));
      allow create: if permission('can_manage_documents')
        && checklistItemMatchesParent(request.resource.data);
      allow update: if permission('can_manage_documents')
        && checklistItemMatchesParent(request.resource.data)
        && resource.data.get('document_id', '') == request.resource.data.get('document_id', '');
      allow delete: if permission('can_manage_documents');
    }

    match /document_signatures/{signatureId} {
      // A signature belongs to the member who gave it - the same shape as training_signatures. There is no
      // `can_sign_documents` flag in the role table, and there should not be: signing is what every member does, and
      // the rule that matters is that nobody can sign as somebody else.
      // THE NULL GUARD IS THIS FILE'S OWN RULE OF THE ROAD, and the note on announcements (above) says why: `.data` off a
      // null `resource` is an EVALUATION ERROR, which a client cannot tell apart from a refusal. Firestore only proves
      // `resource.data.user_id == uid()` for a query constrained by `where('user_id', '==', uid)`, and every screen that
      // reads a document's signatures reads them BY DOCUMENT instead - so this rule is evaluated with `resource == null`
      // on exactly the queries the back-fill panel and the verification queue make before they act.
      //
      // WHAT IT IS WORTH, STATED PLAINLY: removing this guard changes no outcome any check can see. A caller whose access
      // comes from a permission below passes either way, and a caller without one is refused either way - the guard turns
      // an evaluation error into a clean refusal, and nothing else. It stays because the error class is invisible when it
      // happens (it reads as "you do not have permission" for an action that was never a permission question) and because
      // a later edit that removed a permission branch would otherwise fail this way with nothing to point at.
      allow read: if signedIn()
        && ((resource != null && resource.data.user_id == uid())
          || permission('can_verify_documents')
          || permission('can_manage_documents'));
      // TWO SHAPES OF ROW ARE CREATED HERE, by two different people.
      //
      // A MEMBER's own signature: about them AND attributed to them, role 'member', and only with `can_view_documents` -
      // signing a document you are not allowed to read is not a thing. The sheet checked that permission in its handler;
      // here it is a rule, so a client that skips the handler entirely still cannot.
      //
      // A VERIFIER's row: about the member and attributed to the VERIFIER. It is the one row a client may create that is
      // not about itself, so it names it role 'verifier' and it must carry the caller as the signer: a verifier can say
      // "I checked this", never "somebody else checked it". There is no update path for either - a verification is a new
      // row rather than an edit of the member's, which is what keeps the two signatures and the two people legible.
      // `get(key, default)` rather than `data.key`, and that is not a style choice: reading a field that is NOT THERE
      // makes the rule ERROR, and an error is indistinguishable from a denial in the log - which is how a malformed
      // client write turns into an afternoon of "the rules say no". With a default, a missing field is simply `false`.
      allow create: if signedIn()
        && ((request.resource.data.get('user_id', '') == uid()
              && request.resource.data.get('signed_by_user_id', '') == uid()
              && request.resource.data.get('signature_role', '') == 'member'
              && permission('can_view_documents'))
            || (permission('can_verify_documents')
              && request.resource.data.get('user_id', '') != uid()
              && request.resource.data.get('signed_by_user_id', '') == uid()
              && request.resource.data.get('signature_role', '') == 'verifier')
            || (isAdministrator()
              && request.resource.data.get('user_id', '') == uid()
              && request.resource.data.get('signed_by_user_id', '') == uid()
              && request.resource.data.get('signature_role', '') == 'verifier')
            // A BACK-FILL, and the `backfilled == true` clause is the whole reason this branch is safe to add. An
            // administrator may record a signature for SOMEBODY ELSE, which is what grandfathering the paper files
            // needs - and may only do it while saying so. Without that clause this branch would be a way to write an
            // ordinary in-app signature in another member's name, which is the one thing the two branches above exist
            // to prevent; with it, the row cannot pretend to be something a member tapped.
            //
            // `get(k, default)` throughout, as above: reading a field that is NOT there makes a rule ERROR, and an
            // error is indistinguishable from a denial in the log.
            || (permission('can_manage_documents')
              && request.resource.data.get('user_id', '') != uid()
              && request.resource.data.get('signed_by_user_id', '') == uid()
              && request.resource.data.get('signature_role', '') == 'member'
              && request.resource.data.get('backfilled', false) == true));
      allow update, delete: if permission('can_manage_documents');
    }

    // An assessment score: one member's result on one assessment, as free text and the day it was taken.
    //
    // THIS COLLECTION IS THE POINT OF THE WHOLE FEATURE, and the asymmetry between its two halves is deliberate.
    //
    // READ: your own score, always. Anybody else's, only if you may add scores - because somebody who can enter a
    // score has to be able to see what is already on file, or the panel would let them overwrite it blind. The same
    // shape as document_signatures above, and for the same reason.
    //
    // WRITE: `can_add_assessment_scores` and NOTHING else. In particular there is NO branch for a member writing their
    // OWN score, even a verified one, even with the member's consent - which is the whole requirement. A member can
    // read their result and cannot touch it; the person who administers the test records it for them.
    //
    // `request.resource.data.user_id != uid()` closes the loop on that from the other side: somebody who administers
    // assessments still may not enter a score for THEMSELVES. That is not paranoia about an officer's honesty - it is
    // that "your score" and "the score the station recorded" are two different statements, and a self-entered one
    // would quietly make them the same. (The checklist rules above take the same position on self-verification.)
    //
    // The field types are asserted rather than assumed. `score is string` is what makes this a STRING column in the
    // database instead of whatever a client sent, so a number written once cannot come back as a number; `scored_on is
    // string` is the same guard on the date. `get(k, default)` rather than `data.k` throughout, because reading a field
    // that is NOT THERE makes the rule ERROR and an error is indistinguishable from a denial in the log.
    match /document_assessment_scores/{scoreId} {
      allow read: if signedIn()
        && (resource.data.user_id == uid()
          || permission('can_add_assessment_scores'));

      allow create, update: if signedIn()
        && permission('can_add_assessment_scores')
        && request.resource.data.get('user_id', '') != ''
        && request.resource.data.get('user_id', '') != uid()
        && request.resource.data.get('document_id', '') != ''
        && request.resource.data.get('score', '') is string
        && request.resource.data.get('score', '') != ''
        && request.resource.data.get('scored_on', '') is string
        && request.resource.data.get('scored_on', '') != ''
        // The scorer is the caller, always. A client cannot file somebody else's name as the officer who did it, which
        // is the only way this row's provenance could be made to lie.
        && request.resource.data.get('scored_by_user_id', '') == uid();

      // Removal is the scorer's, and deliberately not the manager's-only: an assessment that is withdrawn is cleaned up
      // by whoever runs assessments. Kept separate from the update above so the two rules can be reasoned about alone.
      allow delete: if signedIn() && permission('can_add_assessment_scores');
    }

    // Everything not named above is denied, including the collections whose rules arrive with their client code
    // (documents and their signatures). This is the default that makes a missing rule fail closed instead of open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
