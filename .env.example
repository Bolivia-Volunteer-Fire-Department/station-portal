# The Firebase web config that backs the whole app: Firestore, Auth and the callables. These are NOT secrets - a
# Firebase web config is public by design, and the project is protected by security rules and App Check. For local dev,
# copy this file to .env and fill the values in; for GitHub Pages, set them as repository secrets of the same names.
#
# There is no VITE_APPS_SCRIPT_URL any more. The Google Sheet is no longer a backend for anything: every read and write
# goes to Firestore, the login is Firebase's, and the deployed script is kept only as a reference for what the app used
# to do. See docs/MIGRATION_MAP.md.
#
# The values come from the Firebase console: Project settings > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# The FCM web-push certificate key, from Project settings > Cloud Messaging > Web configuration.
VITE_FIREBASE_VAPID_KEY=

# Which routes are on, comma-separated (see src/services/firestoreRouting.js for the names). Leave it UNSET: unset means
# every route whose prerequisites are met, which is the normal state and what a deployment should use. Listing names
# turns on only those, and `off`/`none` is a kill switch for a route that is misbehaving.
#
# It is a KILL SWITCH and nothing else now. There is no sheet to fall back to, so switching a route off means the screens
# that use it fail rather than quietly working from somewhere else - which is the honest behaviour, and worth knowing
# before reaching for it.
VITE_FIRESTORE_FEATURES=
